# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Last.fm API account: https://www.last.fm/api/account/create
# Baked into the build at compile time so packaged installs can scrobble.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Optional, dev only: the Python that runs sidecar/smtc_helper.py when the
# helper exe hasn't been built. Defaults to "python" on PATH.
CINNAMON_PYTHON=
